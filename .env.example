# distributionMapApp environment template.
# Copy to `.env` in the repository root and adjust. Every variable is optional
# except GEE_PROJECT; the values below are the defaults read by backend/config.py.

# --- Google Earth Engine -----------------------------------------------------
# Google Cloud project ID with the Earth Engine API enabled (see `gcloud projects list`).
GEE_PROJECT=your-gcp-project-id
GEE_MODIS_NDVI=MODIS/061/MOD13Q1
GEE_ERA5_LAND_DAILY=ECMWF/ERA5_LAND/DAILY_AGGR
GEE_CHIRPS_DAILY=UCSB-CHG/CHIRPS/DAILY
GEE_S2_SR=COPERNICUS/S2_SR_HARMONIZED

# --- Flask -------------------------------------------------------------------
FLASK_DEBUG=false

# --- CONAGUA stations downloaded on startup (comma-separated keys) ------------
CONAGUA_HIDROS_STATIONS=BDCTB,SPTTB
CONAGUA_CLIMAS_STATIONS=BDCTB,SPTTB

# --- Processing limits (finite numbers greater than zero) --------------------
MAX_SPAN_DEG=8.0
MAX_YEARS_RANGE=10.0
MAX_SPAN_DEG_S2=4.0
MAX_TOTAL_PIXELS=26000000
BASE_PIXELS_PER_FRAME=589824
BASE_PIXELS_S2=262144
MIN_GIF_DIM=256

# --- GIF cache ---------------------------------------------------------------
GIF_MAX_AGE_MINUTES=60
GIF_CLEANUP_INTERVAL_S=600
GIF_DOWNLOAD_TIMEOUT_S=120

# --- Rate limits (Flask-Limiter notation, per endpoint and IP) ---------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GIF=30/minute
RATE_LIMIT_TIMESERIES=60/minute
RATE_LIMIT_EXPORT=10/minute
RATE_LIMIT_FLOOD=60/minute
RATE_LIMIT_FLOOD_STATS=30/minute
RATE_LIMIT_STATION=60/minute
RATE_LIMIT_FORECAST=60/minute

# --- Progress streaming (SSE) ------------------------------------------------
SSE_TASK_QUEUE_TIMEOUT_S=60
SSE_WAIT_ATTEMPTS=100
SSE_PROGRESS_RETENTION_S=3600
SSE_MAX_PROGRESS_TASKS=1024
SSE_MAX_PROGRESS_MESSAGES=128

# --- Boca del Cerro forecast ---------------------------------------------------
# Published forecast JSON (bdctb-forecast/v2) read by /api/v1/forecasts/bdctb.
BDCTB_FORECAST_URL=https://raw.githubusercontent.com/ElGuill3/tabasco-river-forecast/forecasts/bdctb/latest.json
# Optional IPCET messenger. Leave empty to disable uploads. When set, use a
# fine-grained token limited to Contents read/write on
# ElGuill3/tabasco-river-forecast. It stays in the backend and is never logged.
FORECAST_MESSENGER_TOKEN=

# --- Legacy local forecast API (only used by the retired local forecast stack) -
BDCTB_FORECAST_API_BASE_URL=http://127.0.0.1:8765
